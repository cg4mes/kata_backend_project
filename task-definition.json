{
  "family": "kata-backend-production",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "networkMode": "awsvpc",
  "taskRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/kata-backend-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/kata-backend-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "kata-backend",
      "image": "${image_url}",
      "essential": true,
      "cpu": 512,
      "memory": 2048,
      "memoryReservation": 1024,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DB_TYPE",
          "value": "postgres"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        }
      ],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:us-east-1:YOUR_AWS_ACCOUNT_ID:parameter/kata/production/db_host"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:ssm:us-east-1:YOUR_AWS_ACCOUNT_ID:parameter/kata/production/db_username"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:YOUR_AWS_ACCOUNT_ID:parameter/kata/production/db_password"
        },production/db_database"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:YOUR_AWS_ACCOUNT_ID:parameter/kata/production/jwt_secret"
        },
        {
          "name": "CORS_ORIGIN",
          "valueFrom": "arn:aws:ssm:us-east-1:YOUR_AWS_ACCOUNT_ID:parameter/kata/production/cors_origin"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/kata-backend-production",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "mode": "non-blocking",
          "max-buffer-size": "25m"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
