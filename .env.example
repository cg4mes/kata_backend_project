# Backend Environment Variables Template
# Copy this file to .env.qa, .env.staging, or .env.production and fill in the values

# Application
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
# Replace with your RDS endpoint for each environment
DB_TYPE=postgres
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=kata_backend_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT Authentication
# Generate secure secrets with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=24h

# CORS
# QA: https://qa.yourapp.com
# Staging: https://staging.yourapp.com
# Production: https://yourapp.com
CORS_ORIGIN=https://yourapp.com

# AWS Secrets (if using Secrets Manager)
# AWS_REGION=us-east-1
# AWS_SECRET_NAME=kata-backend-secrets

# Logging
LOG_LEVEL=info
